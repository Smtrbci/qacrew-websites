# Configure these as Worker secrets/variables in Cloudflare. Never commit a populated env file.
ANTHROPIC_API_KEY=
TURNSTILE_SECRET_KEY=
FORGE_LOGIN_EMAIL=
FORGE_LOGIN_PASSWORD=
SESSION_SECRET=

# Optional model overrides; current defaults are documented active Anthropic model IDs.
QUICK_MODEL=claude-sonnet-5
DEEP_MODEL=claude-opus-5

# Public unauthenticated generation is intentionally disabled.
ENABLE_PUBLIC_TRY=false
